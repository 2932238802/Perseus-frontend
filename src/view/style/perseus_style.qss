/* ============================================================
 *  Perseus Editor - 主题样式表 (模板)
 *
 *  说明:
 *    此文件是 *主题模板*. 运行时由 LosCore::LosThemeManager 把
 *    @key@ 占位符替换成主题 JSON (resources/highlight/themes/*.json)
 *    中 ui 节定义的颜色字符串, 再通过 setStyleSheet 应用.
 *
 *    所有占位符列表 (与 ui 节字段一一对应):
 *      @background@        @panelBg@           @borderStrong@
 *      @selection@         @muted@             @primary@
 *      @foreground@        @primaryHover@      @primaryPressed@
 *      @danger@            @success@           @successHover@
 *      @successPressed@    @highlightFg@
 *      @mutedAlpha50@      @mutedAlpha55@
 *      @primaryAlpha70@    @primaryAlpha75@
 *      @successAlpha26@    @successAlpha45@
 * ============================================================ */


/* ============================================================
 *  1. 全局基础
 * ============================================================ */

QMainWindow {
    background-color: @background@;
    color: @foreground@;
}

* {
    outline: none;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QWidget {
    color: @foreground@;
}

QTabWidget {
    border: none;
}

QTabBar::base {
    border: none;
    border-bottom: 0px;
    border-top: 0px;
}


/* ============================================================
 *  2. 通用控件 (Tooltip / Menu / MessageBox / InputDialog)
 * ============================================================ */

QToolTip {
    background-color: @panelBg@;
    color: @foreground@;
    border: 1px solid @primary@;
    border-radius: 4px;
    padding: 6px 10px;
}

QMenu {
    background-color: @background@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: @selection@;
    color: @primary@;
}

QMenu::item:disabled {
    color: @muted@;
}

QMenu::separator {
    height: 1px;
    background-color: @selection@;
    margin: 4px 8px;
}

QMessageBox {
    background-color: @background@;
    color: @foreground@;
}

QMessageBox QLabel {
    color: @foreground@;
}

QInputDialog {
    background-color: @background@;
    color: @foreground@;
}


/* ============================================================
 *  3. 顶部工具栏 (#toolbar_widget)
 * ============================================================ */

#toolbar_widget {
    background-color: @panelBg@;
    border-bottom: 1px solid @borderStrong@;
}

#icon_btn,
#files_btn,
#view_btn,
#run_singleFile_btn,
#setting_btn {
    border: 1px solid transparent;
    background-color: transparent;
    color: @foreground@;
    border-radius: 4px;
    padding: 5px 12px;
}

#icon_btn {
    font-weight: bold;
    color: @primary@;
    padding: 4px 0px;
    min-width: 32px;
    text-align: center;
    font-size: 1.2em;
}

#icon_btn:hover,
#files_btn:hover,
#view_btn:hover,
#run_singleFile_btn:hover,
#setting_btn:hover {
    background-color: @selection@;
    color: @highlightFg@;
}

#icon_btn:pressed,
#files_btn:pressed,
#view_btn:pressed,
#run_singleFile_btn:pressed,
#setting_btn:pressed {
    background-color: @muted@;
    color: @highlightFg@;
}

#project_btn {
    background-color: transparent;
    color: @muted@;
    border: none;
    padding: 8px 16px;
    font-weight: bold;
    text-transform: uppercase;
}

#project_btn:hover {
    color: @foreground@;
}

#project_btn:checked {
    color: @primary@;
}

#project_btn::indicator {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border: 2px solid @muted@;
    background-color: transparent;
}

#project_btn::indicator:hover {
    border-color: @primary@;
}

#project_btn::indicator:checked {
    border-color: @primary@;
    background-color: @primary@;
}

#project_dir_label {
    color: @foreground@;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background-color: @selection@;
    border: 1px solid @muted@;
    border-radius: 4px;
    padding: 4px 12px;
    margin-right: 10px;
}

#project_dir_label:hover {
    background-color: @muted@;
    border: 1px solid @primary@;
}


/* ============================================================
 *  4. 左侧活动栏 (#activity_bar_widget)
 * ============================================================ */

#activity_bar_widget {
    background-color: @panelBg@;
    border-right: 1px solid @borderStrong@;
}

#activity_bar_widget QPushButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 6px;
}

#activity_bar_widget QPushButton:hover {
    background-color: transparent;
    border-left: 3px solid @muted@;
}

#activity_bar_widget QPushButton:checked {
    background-color: transparent;
    border-left: 3px solid @primary@;
}

#activity_bar_widget QPushButton:pressed {
    background-color: transparent;
}

#act_explorer_btn {
    image: url(:/icons/files_black.png);
}

#act_explorer_btn:hover,
#act_explorer_btn:checked {
    image: url(:/icons/files_white.png);
}

#act_extensions_btn {
    image: url(:/icons/chajian_black.png);
}

#act_extensions_btn:hover,
#act_extensions_btn:checked {
    image: url(:/icons/chajian_white.png);
}

#act_auth_btn {
    image: url(:/icons/auth_black.png);
}

#act_auth_btn:hover {
    image: url(:/icons/auth_white.png);
}

/* 已登录态: 切换为 loginsuc 图标 */
#act_auth_btn[logged="true"] {
    image: url(:/icons/loginsuc_white.png);
}

#act_auth_btn[logged="true"]:hover {
    image: url(:/icons/loginsuc_white.png);
}


/* ============================================================
 *  5. 主体分割器 (QSplitter)
 * ============================================================ */

QSplitter::handle {
    background-color: @borderStrong@;
    margin: 0px;
}

QSplitter::handle:horizontal:hover,
QSplitter::handle:vertical:hover {
    background-color: @primary@;
}


/* ============================================================
 *  6. 文件树 (QTreeView)
 * ============================================================ */

QTreeView {
    background-color: @background@;
    color: @foreground@;
    border: none;
    show-decoration-selected: 1;
    outline: none;
}

QTreeView::item {
    min-height: 24px;
    padding: 2px 6px;
    border-radius: 4px;
    margin: 1px 4px;
    border: none;
}

QTreeView::item:hover {
    background-color: @selection@;
    color: @highlightFg@;
}

QTreeView::item:selected {
    background-color: @selection@;
    color: @primary@;
    border: none;
}

QTreeView::item:selected:active {
    background-color: @muted@;
    color: @highlightFg@;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:selected {
    background-color: @selection@;
}


/* ============================================================
 *  7. 编辑器 Tab (#editor_tabwidget)
 * ============================================================ */

#editor_tabwidget::pane {
    border: 0px solid transparent;
    background-color: @background@;
    top: -1px;
}

#editor_tabwidget QTabBar {
    background-color: @panelBg@;
    border: none;
    qproperty-drawBase: 0;
}

#editor_tabwidget QTabBar::tab {
    background-color: @panelBg@;
    color: @muted@;
    padding: 6px 8px 6px 14px;
    border: none;
    border-right: 1px solid @borderStrong@;
    min-width: 120px;
    max-width: 260px;
}

#editor_tabwidget QTabBar::tab:selected {
    background-color: @background@;
    color: @foreground@;
    border-top: 2px solid @primary@;
    font-weight: bold;
}

#editor_tabwidget QTabBar::tab:hover:!selected {
    background-color: @selection@;
    color: @foreground@;
}

#editor_tabwidget QTabBar::scroller {
    width: 20px;
}


/* ============================================================
 *  8. 底部 Tab (#bottom_tabwidget)
 * ============================================================ */

#bottom_tabwidget::pane {
    border: 0px solid transparent;
    background-color: @background@;
    top: -1px;
    bottom: -1px;
}

#bottom_tabwidget>QTabBar {
    background-color: @background@;
    border: none;
}

#bottom_tabwidget>QTabBar::tab {
    background-color: transparent;
    color: @muted@;
    padding: 8px 16px;
    border: none;
    text-transform: uppercase;
    font-weight: bold;
}

#bottom_tabwidget>QTabBar::tab:selected {
    color: @primary@;
    border-bottom: 2px solid @primary@;
}

#bottom_tabwidget>QTabBar::tab:hover:!selected {
    color: @foreground@;
}


/* ============================================================
 *  9. 编辑区 / 输出 (QPlainTextEdit)
 * ============================================================ */

QPlainTextEdit {
    background-color: @background@;
    color: @foreground@;
    border: none;
    font-family: "JetBrains Mono", "Consolas", monospace;
    selection-background-color: @selection@;
    selection-color: @foreground@;
    padding: 6px;
}

#output_plaintextedit {
    background-color: @background@;
    color: @foreground@;
}


/* ============================================================
 * 10. 终端面板 (#terminal_tabs)
 * ============================================================ */

#terminal_tabs::pane {
    border: 0px solid transparent;
    background-color: @background@;
    top: -1px;
}

#terminal_tabs QTabBar {
    background-color: @background@;
    border: none;
}

#terminal_tabs QTabBar::tab {
    background-color: @background@;
    color: @muted@;
    padding: 6px 14px;
    border: none;
    border-right: 1px solid @borderStrong@;
    min-width: 60px;
}

#terminal_tabs QTabBar::tab:selected {
    background-color: @panelBg@;
    color: @primary@;
}

#terminal_tabs QTabBar::tab:hover:!selected {
    background-color: @selection@;
    color: @foreground@;
}

#terminal_tabs QTabBar::close-button {
    subcontrol-position: right;
    margin-right: 4px;
    border-radius: 3px;
}

#terminal_tabs QTabBar::close-button:hover {
    background-color: @danger@;
    border-radius: 3px;
}


/* ============================================================
 * 11. 插件市场 (#LosPlugUi)
 * ============================================================ */

#LosPlugUi {
    background-color: @background@;
}

#LosPlugUi QLabel#titleLabel {
    color: @primary@;
    font-weight: bold;
    text-transform: uppercase;
    padding-left: 4px;
}

#LosPlugUi QLineEdit#searchLineEdit {
    background-color: @panelBg@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 4px;
    padding: 6px 10px;
}

#LosPlugUi QLineEdit#searchLineEdit:focus {
    border: 1px solid @primary@;
    background-color: @panelBg@;
}

#LosPlugUi QListWidget#extensionsList {
    background-color: transparent;
    color: @foreground@;
    outline: none;
    border: none;
}

#LosPlugUi QListWidget::item {
    padding: 8px;
    border-radius: 4px;
    border: 1px solid transparent;
    margin: 2px 6px;
}

#LosPlugUi QListWidget::item:hover {
    background-color: @selection@;
}

#LosPlugUi QListWidget::item:selected {
    background-color: @selection@;
    color: @highlightFg@;
    border-left: 3px solid @primary@;
    border-radius: 0px;
}


/* ============================================================
 * 12. 插件详情 (#LosPluginDetailUi)
 * ============================================================ */

#LosPluginDetailUi {
    background-color: @background@;
}

#LosPluginDetailUi #label_icon {
    background-color: @panelBg@;
    border-radius: 8px;
    padding: 4px;
}

#LosPluginDetailUi #label_name {
    color: @foreground@;
    font-size: 1.8em;
    font-weight: bold;
}

#LosPluginDetailUi #label_version {
    color: @muted@;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

#LosPluginDetailUi #btn_install {
    background-color: @primary@;
    color: @background@;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 28px;
    min-width: 100px;
    border: 1px solid @primary@;
}

#LosPluginDetailUi #btn_install:hover {
    background-color: @primaryHover@;
    border: 1px solid @primaryHover@;
}

#LosPluginDetailUi #btn_install:pressed {
    background-color: @primaryPressed@;
    border: 1px solid @primaryPressed@;
    color: @foreground@;
}

#LosPluginDetailUi #btn_install:disabled {
    background-color: @selection@;
    color: @muted@;
    border: 1px solid @selection@;
}

#LosPluginDetailUi #text_description {
    background-color: transparent;
    color: @foreground@;
    border: none;
    border-top: 1px solid @selection@;
    margin-top: 20px;
    padding-top: 20px;
    line-height: 1.6;
}


/* ============================================================
 * 13. 设置面板 (#LosSettingsUi)
 * ============================================================ */

QDialog#LosSettingsUi {
    background-color: @background@;
    color: @foreground@;
}

QDialog#LosSettingsUi QWidget {
    background-color: @background@;
    color: @foreground@;
}

#category_list {
    background-color: @panelBg@;
    border: none;
    border-right: 1px solid @borderStrong@;
    padding-top: 10px;
    outline: none;
}

#category_list::item {
    color: @foreground@;
    padding: 11px 16px;
    border-left: 3px solid transparent;
    min-height: 24px;
}

#category_list::item:hover {
    background-color: @selection@;
    color: @highlightFg@;
}

#category_list::item:selected {
    background-color: @background@;
    color: @primary@;
    font-weight: bold;
    border-left: 3px solid @primary@;
}

#pages_stack,
#page_editor,
#page_terminal,
#page_build,
#page_install,
#page_theme {
    background-color: @background@;
    border: none;
}

#label_title_editor,
#label_title_terminal,
#label_title_build,
#label_title_install,
#label_title_theme {
    color: @primary@;
    border-bottom: 1px solid @selection@;
    padding-bottom: 8px;
    margin-bottom: 12px;
    font-size: 1.5em;
    font-weight: bold;
}

#label_editor_placeholder,
#label_terminal_placeholder,
#label_desc_install,
#label_desc_theme {
    color: @muted@;
    padding: 4px 0px;
}

#page_build QLabel,
#page_install QLabel,
#page_editor QLabel,
#page_terminal QLabel,
#page_theme QLabel {
    color: @foreground@;
    padding-right: 16px;
}

#scrollArea_build_tools,
#scrollArea_install_tools {
    background-color: @background@;
    border: 1px solid @borderStrong@;
    border-radius: 6px;
    padding: 8px;
}

#scrollArea_build_tools > QWidget,
#scrollArea_install_tools > QWidget,
#scrollAreaWidgetContents_build_tools,
#scrollAreaWidgetContents_install_tools {
    background-color: @background@;
}

#scrollArea_build_tools QScrollBar:vertical,
#scrollArea_install_tools QScrollBar:vertical {
    background-color: @panelBg@;
    width: 12px;
    border: none;
    margin: 0px;
}

#scrollArea_build_tools QScrollBar::handle:vertical,
#scrollArea_install_tools QScrollBar::handle:vertical {
    background-color: @mutedAlpha55@;
    border-radius: 6px;
    min-height: 32px;
    margin: 2px;
}

#scrollArea_build_tools QScrollBar::handle:vertical:hover,
#scrollArea_install_tools QScrollBar::handle:vertical:hover {
    background-color: @primaryAlpha75@;
}

#scrollArea_build_tools QScrollBar::add-line,
#scrollArea_build_tools QScrollBar::sub-line,
#scrollArea_build_tools QScrollBar::add-page,
#scrollArea_build_tools QScrollBar::sub-page,
#scrollArea_install_tools QScrollBar::add-line,
#scrollArea_install_tools QScrollBar::sub-line,
#scrollArea_install_tools QScrollBar::add-page,
#scrollArea_install_tools QScrollBar::sub-page {
    background-color: transparent;
    height: 0px;
    width: 0px;
    border: none;
}

#page_build QLineEdit {
    background-color: @panelBg@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 22px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    selection-background-color: @primary@;
    selection-color: @background@;
}

#page_build QLineEdit:hover {
    border: 1px solid @muted@;
}

#page_build QLineEdit:focus {
    border: 1px solid @primary@;
    background-color: @panelBg@;
}

#page_build QLineEdit:disabled {
    background-color: @borderStrong@;
    color: @muted@;
    border: 1px solid @panelBg@;
}

#page_build QToolButton {
    background-color: @selection@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 4px;
    padding: 7px 14px;
    font-weight: bold;
    margin-left: 12px;
    min-width: 38px;
}

#page_build QToolButton:hover {
    background-color: @muted@;
    color: @highlightFg@;
    border: 1px solid @primary@;
}

#page_build QToolButton:pressed {
    background-color: @primary@;
    color: @background@;
    border: 1px solid @primary@;
}

#page_install QLabel {
    min-height: 28px;
    padding-top: 4px;
    padding-bottom: 4px;
}

#page_install QPushButton {
    background-color: @selection@;
    color: @foreground@;
    border: 1px solid @muted@;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: bold;
    min-width: 92px;
}

#page_install QPushButton:hover {
    background-color: @muted@;
    color: @highlightFg@;
    border: 1px solid @primary@;
}

#page_install QPushButton:pressed {
    background-color: @primary@;
    color: @background@;
    border: 1px solid @primary@;
}

#page_install QPushButton:disabled {
    background-color: @panelBg@;
    color: @muted@;
    border: 1px solid @panelBg@;
}

#page_install QPushButton[installed="true"] {
    background-color: @success@;
    color: @background@;
    border: 1px solid @success@;
    font-weight: bold;
}

#page_install QPushButton[installed="true"]:hover {
    background-color: @successHover@;
    color: @background@;
    border: 1px solid @successHover@;
}

#page_install QPushButton[installed="true"]:pressed {
    background-color: @successPressed@;
    color: @background@;
    border: 1px solid @successPressed@;
}

#page_install QPushButton[installed="true"]:disabled {
    background-color: @successAlpha26@;
    color: @foreground@;
    border: 1px solid @successAlpha45@;
    font-weight: bold;
}

#buttonBox {
    margin-top: 10px;
    background-color: @background@;
}

#buttonBox QPushButton {
    background-color: @selection@;
    color: @foreground@;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 18px;
    min-width: 70px;
}

#buttonBox QPushButton:hover {
    background-color: @muted@;
    color: @highlightFg@;
    border: 1px solid @primary@;
}

#buttonBox QPushButton:pressed {
    background-color: @panelBg@;
    border: 1px solid @primary@;
}

#buttonBox QPushButton[text="OK"] {
    background-color: @primary@;
    color: @background@;
    font-weight: bold;
    border: 1px solid @primary@;
}

#buttonBox QPushButton[text="OK"]:hover {
    background-color: @primaryHover@;
    border: 1px solid @primaryHover@;
}

#buttonBox QPushButton[text="OK"]:pressed {
    background-color: @primaryPressed@;
    border: 1px solid @primaryPressed@;
    color: @foreground@;
}


/* ============================================================
 * 14. 滚动条 (QScrollBar)
 * ============================================================ */

QScrollBar:vertical {
    background-color: transparent;
    width: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: @mutedAlpha50@;
    border-radius: 0px;
    min-height: 30px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: @primaryAlpha70@;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: @mutedAlpha50@;
    border-radius: 0px;
    min-width: 30px;
    margin: 0px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @primaryAlpha70@;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
    height: 0px;
    width: 0px;
    border: none;
}


/* ============================================================
 * 15. 通用控件 (QPushButton / QLineEdit / QComboBox / QCheckBox)
 * ============================================================ */

QPushButton {
    background-color: @selection@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: @muted@;
    border: 1px solid @primary@;
}

QPushButton:pressed {
    background-color: @primary@;
    color: @background@;
}

QPushButton:disabled {
    background-color: @panelBg@;
    color: @muted@;
    border: 1px solid @panelBg@;
}

QLineEdit {
    background-color: @panelBg@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: @primary@;
    selection-color: @background@;
}

QLineEdit:focus {
    border: 1px solid @primary@;
}

QComboBox {
    background-color: @panelBg@;
    color: @foreground@;
    border: 1px solid @selection@;
    border-radius: 4px;
    padding: 4px 10px;
}

QComboBox:hover {
    border: 1px solid @muted@;
}

QComboBox QAbstractItemView {
    background-color: @background@;
    color: @foreground@;
    selection-background-color: @selection@;
    selection-color: @primary@;
    border: 1px solid @selection@;
}

QCheckBox {
    color: @foreground@;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @muted@;
    border-radius: 3px;
    background-color: @panelBg@;
}

QCheckBox::indicator:hover {
    border: 1px solid @primary@;
}

QCheckBox::indicator:checked {
    background-color: @primary@;
    border: 1px solid @primary@;
}


/* ============================================================
 * 16. 底部状态栏 (LosView::LosStateBarUi)
 * ============================================================ */

LosView--LosStateBarUi {
    background-color: @panelBg@;
    border-top: 1px solid @borderStrong@;
}

LosView--LosStateBarUi QLabel {
    color: @muted@;
    padding: 0 8px;
    margin: 0;
    background: transparent;
}

LosView--LosStateBarUi QLabel:hover {
    background-color: @selection@;
    color: @foreground@;
}

#statusbar_label {
    color: @muted@;
}

#statusbar_coding_label {
    color: @primary@;
