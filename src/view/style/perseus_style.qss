/* ============================================================
 *  Perseus Editor - 主题样式表 (Dracula 风格)
 *
 *  目录:
 *    1. 全局基础         (主窗口 / 通用 QWidget / 字体)
 *    2. 通用控件         (QToolTip / QMenu / QMessageBox)
 *    3. 顶部工具栏        (#toolbar_widget 及其按钮)
 *    4. 左侧活动栏        (#activity_bar_widget)
 *    5. 主体分割器        (QSplitter)
 *    6. 文件树           (QTreeView)
 *    7. 编辑器 Tab        (#editor_tabwidget)
 *    8. 底部 Tab         (#bottom_tabwidget)
 *    9. 输出 / 编辑器     (QPlainTextEdit)
 *   10. 终端面板         (#terminal_tabs)
 *   11. 插件市场         (#LosPlugUi)
 *   12. 插件详情         (#LosPluginDetailUi)
 *   13. 设置面板         (#LosSettingsUi)
 *   14. 滚动条           (QScrollBar)
 *   15. 通用控件         (QPushButton / QLineEdit / QComboBox / QCheckBox)
 *   16. 底部状态栏       (LosView::LosStateBarUi)
 *
 *  调色板 (Dracula):
 *    背景         #282a36
 *    更暗背景      #21222c
 *    最暗 / 边框   #191a21
 *    选中 / 行     #44475a
 *    深紫蓝       #6272a4
 *    主紫色       #bd93f9
 *    前景         #f8f8f2
 *    辅紫         #caa9fa
 *    强调红       #ff5555
 * ============================================================ */


/* ============================================================
 *  1. 全局基础
 * ============================================================ */

QMainWindow {
    background-color: #282a36;
    color: #f8f8f2;
}

* {
    outline: none;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QWidget {
    color: #f8f8f2;
}

QTabWidget {
    border: none;
}

QTabBar::base {
    border: none;
    border-bottom: 0px;
    border-top: 0px;
}


/* ============================================================
 *  2. 通用控件 (Tooltip / Menu / MessageBox / InputDialog)
 * ============================================================ */

QToolTip {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #bd93f9;
    border-radius: 4px;
    padding: 6px 10px;
}

QMenu {
    background-color: #282a36;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #44475a;
    color: #bd93f9;
}

QMenu::item:disabled {
    color: #6272a4;
}

QMenu::separator {
    height: 1px;
    background-color: #44475a;
    margin: 4px 8px;
}

QMessageBox {
    background-color: #282a36;
    color: #f8f8f2;
}

QMessageBox QLabel {
    color: #f8f8f2;
}

QInputDialog {
    background-color: #282a36;
    color: #f8f8f2;
}


/* ============================================================
 *  3. 顶部工具栏 (#toolbar_widget)
 *     - 包含 icon_btn / files_btn / view_btn / setting_btn
 *       run_singleFile_btn / project_btn / project_dir_label
 * ============================================================ */

#toolbar_widget {
    background-color: #21222c;
    border-bottom: 1px solid #191a21;
}

/* 工具栏左侧普通按钮 (扁平、悬停高亮) */
#icon_btn,
#files_btn,
#view_btn,
#run_singleFile_btn,
#setting_btn {
    border: 1px solid transparent;
    background-color: transparent;
    color: #f8f8f2;
    border-radius: 4px;
    padding: 5px 12px;
}

/* 左上角 "P" 图标按钮 */
#icon_btn {
    font-weight: bold;
    color: #bd93f9;
    padding: 4px 0px;
    min-width: 32px;
    text-align: center;
    font-size: 1.2em;
}

#icon_btn:hover,
#files_btn:hover,
#view_btn:hover,
#run_singleFile_btn:hover,
#setting_btn:hover {
    background-color: #44475a;
    color: #ffffff;
}

#icon_btn:pressed,
#files_btn:pressed,
#view_btn:pressed,
#run_singleFile_btn:pressed,
#setting_btn:pressed {
    background-color: #6272a4;
    color: #ffffff;
}

/* 工具栏单选按钮 "CMake Pro?" */
#project_btn {
    background-color: transparent;
    color: #6272a4;
    border: none;
    padding: 8px 16px;
    font-weight: bold;
    text-transform: uppercase;
}

#project_btn:hover {
    color: #f8f8f2;
}

#project_btn:checked {
    color: #bd93f9;
}

/* 单选按钮的小圆点 */
#project_btn::indicator {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border: 2px solid #6272a4;
    background-color: transparent;
}

#project_btn::indicator:hover {
    border-color: #bd93f9;
}

#project_btn::indicator:checked {
    border-color: #bd93f9;
    background-color: #bd93f9;
}

/* 工具栏右侧 "项目路径" 显示标签 */
#project_dir_label {
    color: #f8f8f2;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background-color: #44475a;
    border: 1px solid #6272a4;
    border-radius: 4px;
    padding: 4px 12px;
    margin-right: 10px;
}

#project_dir_label:hover {
    background-color: #6272a4;
    border: 1px solid #bd93f9;
}


/* ============================================================
 *  4. 左侧活动栏 (#activity_bar_widget)
 *     - 仿 VSCode 左侧最窄的那一列
 *     - 选中: 左侧出现紫色高亮线
 *     - 切换图标 (黑/白) 来表达 hover/checked
 * ============================================================ */

#activity_bar_widget {
    background-color: #21222c;
    border-right: 1px solid #191a21;
}

#activity_bar_widget QPushButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 6px;
}

#activity_bar_widget QPushButton:hover {
    background-color: transparent;
    border-left: 3px solid #6272a4;
}

#activity_bar_widget QPushButton:checked {
    background-color: transparent;
    border-left: 3px solid #bd93f9;
}

#activity_bar_widget QPushButton:pressed {
    background-color: transparent;
}

/* 文件树按钮 */
#act_explorer_btn {
    image: url(:/icons/files_black.png);
}

#act_explorer_btn:hover,
#act_explorer_btn:checked {
    image: url(:/icons/files_white.png);
}

/* 插件按钮 */
#act_extensions_btn {
    image: url(:/icons/chajian_black.png);
}

#act_extensions_btn:hover,
#act_extensions_btn:checked {
    image: url(:/icons/chajian_white.png);
}


/* ============================================================
 *  5. 主体分割器 (QSplitter)
 *     - 横向: 左侧栏 / 右侧编辑器
 *     - 纵向: 编辑器 / 底部面板
 * ============================================================ */

QSplitter::handle {
    background-color: #191a21;
    margin: 0px;
}

QSplitter::handle:horizontal:hover,
QSplitter::handle:vertical:hover {
    background-color: #bd93f9;
}


/* ============================================================
 *  6. 文件树 (QTreeView)
 *     - 用于左侧的资源管理器
 * ============================================================ */

QTreeView {
    background-color: #282a36;
    color: #f8f8f2;
    border: none;
    show-decoration-selected: 1;
    font-size: 13px;
    outline: none;
}

QTreeView::item {
    height: 24px;
    padding: 2px 6px;
    border-radius: 4px;
    margin: 1px 4px;
    border: none;
}

QTreeView::item:hover {
    background-color: #44475a;
    color: #ffffff;
}

QTreeView::item:selected {
    background-color: #44475a;
    color: #bd93f9;
    border: none;
}

QTreeView::item:selected:active {
    background-color: #6272a4;
    color: #ffffff;
}

QTreeView::branch {
    background-color: transparent;
}

QTreeView::branch:selected {
    background-color: #44475a;
}


/* ============================================================
 *  7. 编辑器 Tab (#editor_tabwidget)
 *     - 顶部已打开的代码文件页签
 * ============================================================ */

#editor_tabwidget::pane {
    border: 0px solid transparent;
    background-color: #282a36;
    top: -1px;
}

#editor_tabwidget QTabBar {
    background-color: #21222c;
    border: none;
    qproperty-drawBase: 0;
}

#editor_tabwidget QTabBar::tab {
    background-color: #21222c;
    color: #6272a4;
    padding: 6px 8px 6px 14px;
    border: none;
    border-right: 1px solid #191a21;
    min-width: 120px;
    max-width: 260px;
    font-size: 13px;
    height: 26px;
}

#editor_tabwidget QTabBar::tab:selected {
    background-color: #282a36;
    color: #f8f8f2;
    border-top: 2px solid #bd93f9;
    font-weight: bold;
}

#editor_tabwidget QTabBar::tab:hover:!selected {
    background-color: #44475a;
    color: #f8f8f2;
}

#editor_tabwidget QTabBar::scroller {
    width: 20px;
}


/* ============================================================
 *  8. 底部 Tab (#bottom_tabwidget)
 *     - Output / Issues / Terminal
 * ============================================================ */

#bottom_tabwidget::pane {
    border: 0px solid transparent;
    background-color: #282a36;
    top: -1px;
    bottom: -1px;
}

#bottom_tabwidget>QTabBar {
    background-color: #282a36;
    border: none;
}

#bottom_tabwidget>QTabBar::tab {
    background-color: transparent;
    color: #6272a4;
    padding: 8px 16px;
    border: none;
    text-transform: uppercase;
    font-weight: bold;
}

#bottom_tabwidget>QTabBar::tab:selected {
    color: #bd93f9;
    border-bottom: 2px solid #bd93f9;
}

#bottom_tabwidget>QTabBar::tab:hover:!selected {
    color: #f8f8f2;
}


/* ============================================================
 *  9. 编辑区 / 输出 (QPlainTextEdit)
 * ============================================================ */

QPlainTextEdit {
    background-color: #282a36;
    color: #f8f8f2;
    border: none;
    font-family: "JetBrains Mono", "Consolas", monospace;
    selection-background-color: #44475a;
    selection-color: #f8f8f2;
    padding: 6px;
}

#output_plaintextedit {
    background-color: #282a36;
    color: #f8f8f2;
}


/* ============================================================
 * 10. 终端面板 (#terminal_tabs)
 * ============================================================ */

#terminal_tabs::pane {
    border: 0px solid transparent;
    background-color: #282a36;
    top: -1px;
}

#terminal_tabs QTabBar {
    background-color: #282a36;
    border: none;
}

#terminal_tabs QTabBar::tab {
    background-color: #282a36;
    color: #6272a4;
    padding: 6px 14px;
    border: none;
    border-right: 1px solid #191a21;
    min-width: 60px;
}

#terminal_tabs QTabBar::tab:selected {
    background-color: #21222c;
    color: #bd93f9;
}

#terminal_tabs QTabBar::tab:hover:!selected {
    background-color: #44475a;
    color: #f8f8f2;
}

#terminal_tabs QTabBar::close-button {
    subcontrol-position: right;
    margin-right: 4px;
    border-radius: 3px;
}

#terminal_tabs QTabBar::close-button:hover {
    background-color: #ff5555;
    border-radius: 3px;
}


/* ============================================================
 * 11. 插件市场 (#LosPlugUi)
 * ============================================================ */

#LosPlugUi {
    background-color: #282a36;
}

#LosPlugUi QLabel#titleLabel {
    color: #bd93f9;
    font-weight: bold;
    text-transform: uppercase;
    padding-left: 4px;
}

#LosPlugUi QLineEdit#searchLineEdit {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 6px 10px;
}

#LosPlugUi QLineEdit#searchLineEdit:focus {
    border: 1px solid #bd93f9;
    background-color: #21222c;
}

#LosPlugUi QListWidget#extensionsList {
    background-color: transparent;
    color: #f8f8f2;
    outline: none;
    border: none;
}

#LosPlugUi QListWidget::item {
    padding: 8px;
    border-radius: 4px;
    border: 1px solid transparent;
    margin: 2px 6px;
}

#LosPlugUi QListWidget::item:hover {
    background-color: #44475a;
}

#LosPlugUi QListWidget::item:selected {
    background-color: #44475a;
    color: #ffffff;
    border-left: 3px solid #bd93f9;
    border-radius: 0px;
}


/* ============================================================
 * 12. 插件详情 (#LosPluginDetailUi)
 * ============================================================ */

#LosPluginDetailUi {
    background-color: #282a36;
}

#LosPluginDetailUi #label_icon {
    background-color: #21222c;
    border-radius: 8px;
    padding: 4px;
}

#LosPluginDetailUi #label_name {
    color: #f8f8f2;
    font-size: 1.8em;
    font-weight: bold;
}

#LosPluginDetailUi #label_version {
    color: #6272a4;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

#LosPluginDetailUi #btn_install {
    background-color: #bd93f9;
    color: #282a36;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 28px;
    min-width: 100px;
    border: 1px solid #bd93f9;
}

#LosPluginDetailUi #btn_install:hover {
    background-color: #caa9fa;
    border: 1px solid #caa9fa;
}

#LosPluginDetailUi #btn_install:pressed {
    background-color: #9580d4;
    border: 1px solid #9580d4;
    color: #f8f8f2;
}

#LosPluginDetailUi #btn_install:disabled {
    background-color: #44475a;
    color: #6272a4;
    border: 1px solid #44475a;
}

#LosPluginDetailUi #text_description {
    background-color: transparent;
    color: #f8f8f2;
    border: none;
    border-top: 1px solid #44475a;
    margin-top: 20px;
    padding-top: 20px;
    line-height: 1.6;
}


/* ============================================================
 * 13. 设置面板 (#LosSettingsUi)
 *     - 左侧分类 + 右侧多页面
 *     - Build & Run / Install Tools 页面支持滚动
 * ============================================================ */

QDialog#LosSettingsUi {
    background-color: #282a36;
    color: #f8f8f2;
}

QDialog#LosSettingsUi QWidget {
    background-color: #282a36;
    color: #f8f8f2;
}

/* 左侧分类列表 */
#category_list {
    background-color: #21222c;
    border: none;
    border-right: 1px solid #191a21;
    padding-top: 10px;
    outline: none;
}

#category_list::item {
    color: #f8f8f2;
    padding: 11px 16px;
    border-left: 3px solid transparent;
    min-height: 24px;
}

#category_list::item:hover {
    background-color: #44475a;
    color: #ffffff;
}

#category_list::item:selected {
    background-color: #282a36;
    color: #bd93f9;
    font-weight: bold;
    border-left: 3px solid #bd93f9;
}

/* 右侧页面容器 */
#pages_stack,
#page_editor,
#page_terminal,
#page_build,
#page_install {
    background-color: #282a36;
    border: none;
}

/* 页面标题 */
#label_title_editor,
#label_title_terminal,
#label_title_build,
#label_title_install {
    color: #bd93f9;
    border-bottom: 1px solid #44475a;
    padding-bottom: 8px;
    margin-bottom: 12px;
    font-size: 1.5em;
    font-weight: bold;
}

#label_editor_placeholder,
#label_terminal_placeholder,
#label_desc_install {
    color: #6272a4;
    padding: 4px 0px;
}

#page_build QLabel,
#page_install QLabel,
#page_editor QLabel,
#page_terminal QLabel {
    color: #f8f8f2;
    padding-right: 16px;
}

/* Build / Install 滚动区域 */
#scrollArea_build_tools,
#scrollArea_install_tools {
    background-color: #282a36;
    border: 1px solid #191a21;
    border-radius: 6px;
    padding: 8px;
}

#scrollArea_build_tools > QWidget,
#scrollArea_install_tools > QWidget,
#scrollAreaWidgetContents_build_tools,
#scrollAreaWidgetContents_install_tools {
    background-color: #282a36;
}

#scrollArea_build_tools QScrollBar:vertical,
#scrollArea_install_tools QScrollBar:vertical {
    background-color: #21222c;
    width: 12px;
    border: none;
    margin: 0px;
}

#scrollArea_build_tools QScrollBar::handle:vertical,
#scrollArea_install_tools QScrollBar::handle:vertical {
    background-color: rgba(98, 114, 164, 0.55);
    border-radius: 6px;
    min-height: 32px;
    margin: 2px;
}

#scrollArea_build_tools QScrollBar::handle:vertical:hover,
#scrollArea_install_tools QScrollBar::handle:vertical:hover {
    background-color: rgba(189, 147, 249, 0.75);
}

#scrollArea_build_tools QScrollBar::add-line,
#scrollArea_build_tools QScrollBar::sub-line,
#scrollArea_build_tools QScrollBar::add-page,
#scrollArea_build_tools QScrollBar::sub-page,
#scrollArea_install_tools QScrollBar::add-line,
#scrollArea_install_tools QScrollBar::sub-line,
#scrollArea_install_tools QScrollBar::add-page,
#scrollArea_install_tools QScrollBar::sub-page {
    background-color: transparent;
    height: 0px;
    width: 0px;
    border: none;
}

/* 工具路径输入框 */
#page_build QLineEdit {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 22px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    selection-background-color: #bd93f9;
    selection-color: #282a36;
}

#page_build QLineEdit:hover {
    border: 1px solid #6272a4;
}

#page_build QLineEdit:focus {
    border: 1px solid #bd93f9;
    background-color: #21222c;
}

#page_build QLineEdit:disabled {
    background-color: #191a21;
    color: #6272a4;
    border: 1px solid #21222c;
}

/* 浏览按钮 */
#page_build QToolButton {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 7px 14px;
    font-weight: bold;
    margin-left: 12px;
    min-width: 38px;
}

#page_build QToolButton:hover {
    background-color: #6272a4;
    color: #ffffff;
    border: 1px solid #bd93f9;
}

#page_build QToolButton:pressed {
    background-color: #bd93f9;
    color: #282a36;
    border: 1px solid #bd93f9;
}

/* 安装页说明与按钮 */
#page_install QLabel {
    min-height: 28px;
    padding-top: 4px;
    padding-bottom: 4px;
}

#page_install QPushButton {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #6272a4;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: bold;
    min-width: 92px;
}

#page_install QPushButton:hover {
    background-color: #6272a4;
    color: #ffffff;
    border: 1px solid #bd93f9;
}

#page_install QPushButton:pressed {
    background-color: #bd93f9;
    color: #282a36;
    border: 1px solid #bd93f9;
}

#page_install QPushButton:disabled {
    background-color: #21222c;
    color: #6272a4;
    border: 1px solid #21222c;
}

/* 已安装状态：C++ 里给按钮 setProperty("installed", true) 后生效 */
#page_install QPushButton[installed="true"] {
    background-color: #50fa7b;
    color: #282a36;
    border: 1px solid #50fa7b;
    font-weight: bold;
}

#page_install QPushButton[installed="true"]:hover {
    background-color: #69ff94;
    color: #282a36;
    border: 1px solid #69ff94;
}

#page_install QPushButton[installed="true"]:pressed {
    background-color: #3fd96a;
    color: #282a36;
    border: 1px solid #3fd96a;
}

#page_install QPushButton[installed="true"]:disabled {
    background-color: rgba(80, 250, 123, 0.26);
    color: #f8f8f2;
    border: 1px solid rgba(80, 250, 123, 0.45);
    font-weight: bold;
}

/* 底部按钮区 */
#buttonBox {
    margin-top: 10px;
    background-color: #282a36;
}

#buttonBox QPushButton {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 18px;
    min-width: 70px;
}

#buttonBox QPushButton:hover {
    background-color: #6272a4;
    color: #ffffff;
    border: 1px solid #bd93f9;
}

#buttonBox QPushButton:pressed {
    background-color: #21222c;
    border: 1px solid #bd93f9;
}

#buttonBox QPushButton[text="OK"] {
    background-color: #bd93f9;
    color: #282a36;
    font-weight: bold;
    border: 1px solid #bd93f9;
}

#buttonBox QPushButton[text="OK"]:hover {
    background-color: #caa9fa;
    border: 1px solid #caa9fa;
}

#buttonBox QPushButton[text="OK"]:pressed {
    background-color: #9580d4;
    border: 1px solid #9580d4;
    color: #f8f8f2;
}


/* ============================================================
 * 14. 滚动条 (QScrollBar)
 *     - 半透明、悬停时变紫
 * ============================================================ */

QScrollBar:vertical {
    background-color: transparent;
    width: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(98, 114, 164, 0.5);
    border-radius: 0px;
    min-height: 30px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(189, 147, 249, 0.7);
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(98, 114, 164, 0.5);
    border-radius: 0px;
    min-width: 30px;
    margin: 0px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(189, 147, 249, 0.7);
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
    height: 0px;
    width: 0px;
    border: none;
}


/* ============================================================
 * 15. 通用控件 (QPushButton / QLineEdit / QComboBox / QCheckBox)
 *     - 这一段是 *默认* 样式, 各模块如果有需要可以再覆盖
 * ============================================================ */

QPushButton {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #6272a4;
    border: 1px solid #bd93f9;
}

QPushButton:pressed {
    background-color: #bd93f9;
    color: #282a36;
}

QPushButton:disabled {
    background-color: #21222c;
    color: #6272a4;
    border: 1px solid #21222c;
}

QLineEdit {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #bd93f9;
    selection-color: #282a36;
}

QLineEdit:focus {
    border: 1px solid #bd93f9;
}

QComboBox {
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 4px 10px;
}

QComboBox:hover {
    border: 1px solid #6272a4;
}

QComboBox QAbstractItemView {
    background-color: #282a36;
    color: #f8f8f2;
    selection-background-color: #44475a;
    selection-color: #bd93f9;
    border: 1px solid #44475a;
}

QCheckBox {
    color: #f8f8f2;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #6272a4;
    border-radius: 3px;
    background-color: #21222c;
}

QCheckBox::indicator:hover {
    border: 1px solid #bd93f9;
}

QCheckBox::indicator:checked {
    background-color: #bd93f9;
    border: 1px solid #bd93f9;
}


/* ============================================================
 * 16. 底部状态栏 (LosView::LosStateBarUi)
 *     - 仿 VSCode 底部那一条
 *     - 顶部 1px 分隔线 + 内边距 + 悬停高亮
 *
 *  注意: QSS 里 :: 已被子控件占用, C++ 命名空间要写成 --
 *        LosView::LosStateBarUi  →  LosView--LosStateBarUi
 * ============================================================ */

/* 状态栏整体 (背景 + 顶部分隔线) */
LosView--LosStateBarUi {
    background-color: #21222c;
    border-top: 1px solid #191a21;
}

/* 状态栏内所有 QLabel 默认样式 */
LosView--LosStateBarUi QLabel {
    color: #6272a4;
    font-size: 12px;
    padding: 0 8px;
    margin: 0;
    background: transparent;
}

/* 鼠标悬停时的高亮背景 */
LosView--LosStateBarUi QLabel:hover {
    background-color: #44475a;
    color: #f8f8f2;
}

/* 左侧消息: "Ready" / "Loading..." */
#statusbar_label {
    color: #6272a4;
}

/* 右侧文件编码 (UTF-8 / GBK / ...) */
#statusbar_coding_label {
    color: #bd93f9;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

/* 右侧文件语言 (cpp / py / rs / ...) */
#statusbar_lang_label {
    color: #f8f8f2;
    font-family: "JetBrains Mono", "Consolas", monospace;
}
