{
  "name": "light",
  "displayName": "Perseus Light",
  "editor": {
    "foreground": "#24292f",
    "background": "#ffffff",
    "selection": "#c8e1ff",
    "lineNumber": "#8c959f",
    "currentLine": "#f6f8fa"
  },
  "formats": {
    "keyword": { "foreground": "#cf222e", "bold": true },
    "qtKeyword": { "foreground": "#cf222e", "italic": true },
    "preprocessor": { "foreground": "#953800" },
    "builtin": { "foreground": "#8250df" },
    "class": { "foreground": "#0550ae", "bold": true },
    "struct": { "foreground": "#0550ae", "bold": true },
    "type": { "foreground": "#0550ae" },
    "typeParameter": { "foreground": "#0550ae" },
    "interface": { "foreground": "#0550ae" },
    "enum": { "foreground": "#0550ae" },
    "function": { "foreground": "#8250df" },
    "method": { "foreground": "#8250df" },
    "decorator": { "foreground": "#8250df", "italic": true },
    "string": { "foreground": "#0a3069" },
    "char": { "foreground": "#0a3069" },
