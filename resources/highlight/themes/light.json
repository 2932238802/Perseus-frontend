    "number": { "foreground": "#0550ae" },
    "operator": { "foreground": "#cf222e" },
    "variable": { "foreground": "#24292f" },
    "parameter": { "foreground": "#953800", "italic": true },
    "property": { "foreground": "#116329" },
    "field": { "foreground": "#116329" },
    "macro": { "foreground": "#cf222e" },
    "enumMember": { "foreground": "#0550ae" },
    "namespace": { "foreground": "#24292f" },
    "label": { "foreground": "#953800" },
    "regexp": { "foreground": "#0a3069" },
    "event": { "foreground": "#8250df" },
    "modifier": { "foreground": "#cf222e" }
  }
